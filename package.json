{
  "name": "codex-quota",
  "version": "1.2.0",
  "description": "Standalone Codex quota remaining overlay",
  "author": "CodeLV8",
  "repository": {
    "type": "git",
    "url": "https://github.com/dekwatdesign/CodeLV8-Codex-Quota.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && node --check electron/main.mjs && node --check electron/preload.cjs && node --check electron/quota-client.mjs && node --check electron/codex-account-usage.mjs && node --check electron/codex-binary.mjs && node --check electron/spawnable-command.mjs && node --check electron/state.mjs && node --check electron/updater.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis dir --x64",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wait-on": "9.1.0"
  }
}
